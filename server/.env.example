# Server — Backend Environment Variables
# Copy this to .env and fill in your values

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/code_debugging_db?retryWrites=true&w=majority

# JWT signing secret (use a long random string in production)
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Server port (Render sets this automatically)
PORT=5000

# Production mode
NODE_ENV=production

# Admin credentials (auto-seeded on first boot)
ADMIN_EMAIL=admin@devdynasty.com
ADMIN_PASSWORD=admin123

# Your Vercel frontend URL (for CORS)
CLIENT_URL=https://your-app.vercel.app
